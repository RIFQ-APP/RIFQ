generator client {
  provider = "prisma-client-js"
}

// محلياً: SQLite | على Vercel: ضع DATABASE_URL من Neon أو Supabase (PostgreSQL)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lastReading  LastReading?
  favorites    Favorite[]
  notes        Note[]
  hifzProgress HifzProgress[]
  preferences  UserPreferences?
}

model LastReading {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  ayahNumber  Int
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  surahNumber Int?
  ayahNumber  Int?
  contentId   String?
  title       String?
  createdAt   DateTime @default(now())

  @@unique([userId, type, surahNumber, ayahNumber])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int?
  ayahNumber  Int?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HifzProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  ayahNumber  Int
  status      String
  updatedAt   DateTime @updatedAt

  @@unique([userId, surahNumber, ayahNumber])
}

model UserPreferences {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredReciter String  @default("ar.alafasy")
  fontSize         Int     @default(24)
  theme            String  @default("system")
  dailyGoal        Int?
}
